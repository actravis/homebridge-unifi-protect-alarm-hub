# Dependencies
node_modules/

# Build output
dist/
build/
*.tsbuildinfo
*.tgz

# Spike — THROWAWAY. Its output contains device names, zone labels, and MACs
# (effectively a map of the home) and must never be committed. Delete the whole
# spike/ folder before publishing the plugin.
spike/output/
spike/**/*.log

# Local Homebridge test instances (contain the API key + paired state).
# Glob, not a single path: debugging tends to spawn extra data dirs
# (hb-test-cams/, hb-test-cams-bare/, …) and every one of them holds the key.
hb-test*/

# Logs
*.log
npm-debug.log*
yarn-error.log*

# Secrets / local env
.env
.env.*
*.pem
*.key
*.crt
*.p12
*.pfx
.npmrc
# A hand-dropped Homebridge config at the repo root holds the API key. The hb-test*/ rule
# above only covers directories, so name the bare file explicitly.
/config.json

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# Local orientation file (git-ignored globally too; never commit)
CLAUDE.md

# Local Claude Code settings (personal, not shared)
.claude/settings.local.json

# Camera probe (throwaway, same as alarm spike) — never commit
spike/
