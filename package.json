{
  "name": "homebridge-unifi-protect-integration",
  "displayName": "UniFi Protect (Integration API)",
  "version": "0.2.0",
  "description": "HomeKit for UniFi Protect over the official Integration API \u2014 Alarm Hub arm/disarm and sensors today, cameras and more on the roadmap. Security-first: revocable API key, no reverse-engineering.",
  "author": "Andrew Travis",
  "license": "MIT",
  "type": "commonjs",
  "main": "dist/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/actravis/homebridge-unifi-protect-alarm-hub.git"
  },
  "bugs": {
    "url": "https://github.com/actravis/homebridge-unifi-protect-alarm-hub/issues"
  },
  "homepage": "https://github.com/actravis/homebridge-unifi-protect-alarm-hub#readme",
  "funding": [
    {
      "type": "paypal",
      "url": "https://paypal.me/andrewctravis"
    }
  ],
  "engines": {
    "node": ">=18.17.0",
    "homebridge": ">=1.8.0 || >=2.0.0-beta.0"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "clean": "rm -rf dist",
    "lint": "eslint src test",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepublishOnly": "npm run clean && npm run lint && npm test"
  },
  "files": [
    "dist",
    "config.schema.json",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "homebridge-plugin",
    "unifi",
    "unifi-protect",
    "protect",
    "ubiquiti",
    "udm",
    "integration-api",
    "alarm",
    "alarm-hub",
    "security-system",
    "arm",
    "disarm",
    "camera",
    "doorbell",
    "motion",
    "smart-detect",
    "contact-sensor",
    "homekit"
  ],
  "dependencies": {
    "undici": "^6.21.0"
  },
  "optionalDependencies": {
    "ffmpeg-for-homebridge": "^2.2.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^20.12.0",
    "eslint": "^10.8.0",
    "homebridge": "^1.8.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.0.0"
  }
}
